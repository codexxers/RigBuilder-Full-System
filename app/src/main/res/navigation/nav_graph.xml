<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/buildFragment">

    <fragment
        android:id="@+id/buildFragment"
        android:name="com.rigbuilder.app.ui.fragments.BuildFragment"
        android:label="Build">

        <action
            android:id="@+id/action_build_to_catalog"
            app:destination="@id/catalogFragment" />

        <action
            android:id="@+id/action_build_to_performance"
            app:destination="@id/performanceFragment" />

    </fragment>

    <fragment
        android:id="@+id/catalogFragment"
        android:name="com.rigbuilder.app.ui.fragments.CatalogFragment"
        android:label="Catalog">

        <argument
            android:name="category"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/performanceFragment"
        android:name="com.rigbuilder.app.ui.fragments.PerformanceFragment"
        android:label="Performance" />

</navigation>
