<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Light gradient base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFFFF"
                android:centerColor="#FFFAFAFA"
                android:endColor="#FFF5F5F5"
                android:angle="180" />
        </shape>
    </item>
    <!-- Subtle pink glow at bottom edge -->
    <item android:top="52dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00FFD1DC"
                android:endColor="#44FFD1DC"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
